# SAVO — local environment template
#
# Copy to `.env` and fill in from the Supabase dashboard (Project settings →
# API). `.env` is ignored by git: this repository is public, and an env file is
# not something to publish even when the values in it are publishable.
#
# These three are safe to expose — the anon/publishable key is designed to ship
# inside the browser bundle and is bounded by row-level security. Anything with
# elevated rights (service role, database password, access tokens) belongs in
# `.env.local`, which is never committed, or in Supabase project secrets.

SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# The same three, exposed to the client build by Vite. They must match above.
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
