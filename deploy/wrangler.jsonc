// Local-only workerd config. It loads exactly what `sites.manifest.json`
// uploads — the same Worker module and the same prebuilt `dist` directory — so
// the SPA fallback and the asset behaviour are proven before a deployment
// rather than after one.
{
  "name": "savo-local",
  "main": "site-worker.js",
  "compatibility_date": "2026-11-08",
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": false }
}
